# {$PORT} and {$BACKEND_ORIGIN} come from the Railway service environment.
# Local `docker run`: pass -e PORT=8080 -e BACKEND_ORIGIN=http://host.docker.internal:8000

{
	admin off
	persist_config off
	auto_https off
}

:{$PORT:8080} {
	encode zstd gzip

	# API + media → backend service (private network). Keeps the browser
	# same-origin so the session cookie and SW caching just work.
	@api path /api/*
	handle @api {
		reverse_proxy {$BACKEND_ORIGIN:http://localhost:8080} {
			header_up Host {upstream_hostport}
			header_up X-Forwarded-Host {host}
		}
	}

	# Static PWA. Hashed/immutable assets could get long cache headers later;
	# the service worker is the real cache layer.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		-Server
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), geolocation=(), payment=(), usb=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# The PWA is all first-party, no CDN, no inline handlers. Media/audio are
		# same-origin via the /api/media proxy. blob: covers MediaRecorder playback.
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; media-src 'self' blob:; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
	}

	# Never let the HTML shell or the service worker be stale-cached.
	@nocache path / /index.html /sw.js
	header @nocache Cache-Control "no-cache"

	# Bundled immutable assets (symbols, calming loops, icons) can cache hard.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=604800"
}
