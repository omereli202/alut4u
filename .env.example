# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Runtime
APP_ENV=development            # development | production
FLASK_SECRET_KEY=              # long random string; signs the session cookie
LOG_LEVEL=INFO

# Supabase — the DEV project for local work, the PROD project on Railway prod.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=             # public anon key (used for user-scoped clients)
SUPABASE_SERVICE_ROLE_KEY=     # secret; server-only; narrow system operations
SUPABASE_JWT_SECRET=           # Project Settings > API > JWT secret

# Encryption for refresh tokens stored in device_sessions (Fernet key).
# Generate: ./.conda/bin/python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_TOKEN_ENC_KEY=

# Azure Speech (Hebrew TTS)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
AZURE_SPEECH_VOICE=he-IL-HilaNeural   # or he-IL-AvriNeural

# OpenAI (Phase 6 social stories). Blank = deterministic stub. Confirm the
# current model ids for your account.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_IMAGE_MODEL=dall-e-3

# CORS / hosting
PUBLIC_BASE_URL=http://localhost:8000

# Quotas (per caregiver, per calendar month). 0 = unlimited (dev only).
QUOTA_TTS_CHARS_PER_MONTH=200000
QUOTA_IMAGE_COUNT_PER_MONTH=100
QUOTA_LLM_TOKENS_PER_MONTH=500000

# Data retention — accounts idle this long are warned, then purged.
RETENTION_WARN_DAYS=540
RETENTION_PURGE_DAYS=730

# Observability
SENTRY_DSN=
JSON_LOGS=false        # set true in production for structured log lines
